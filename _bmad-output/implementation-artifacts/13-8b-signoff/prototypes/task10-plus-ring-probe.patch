+/// PROTOTYPE: the holder waits on a job-holder who waits on the next, round to the holder: every
+/// dwarf in the ring steps onto its next tile in this one call.
+fn rotate_ring(ecs: &mut EcsWorld, holder_id: Id, pos: Pos, path: &mut Vec<Pos>, blocker: Entity) -> bool {
+    let at: BTreeMap<Pos, Entity> = ecs
+        .iter_entities()
+        .filter(|entity| entity.contains::<Dwarf>())
+        .filter_map(|entity| Some((*entity.get::<Pos>()?, entity.id())))
+        .collect();
+    let mut ring: Vec<Entity> = Vec::new();
+    let mut current = blocker;
+    loop {
+        if ring.contains(&current) || ring.len() > 64 {
+            return false;
+        }
+        let walking = ecs.get::<JobState>(current) == Some(&JobState::Walk)
+            && ecs.get::<CurrentJob>(current).is_some_and(|job| job.0.is_some());
+        let Some(next) = ecs.get::<Path>(current).and_then(|path| path.0.first().copied()) else {
+            return false;
+        };
+        if !walking {
+            return false;
+        }
+        ring.push(current);
+        if next == pos {
+            break;
+        }
+        let Some(&following) = at.get(&next) else {
+            return false;
+        };
+        current = following;
+    }
+    for member in ring {
+        let mut steps = ecs.get::<Path>(member).expect("checked above").0.clone();
+        let next = steps.remove(0);
+        *ecs.get_mut::<Pos>(member).expect("every dwarf has a position") = next;
+        ecs.get_mut::<Wander>(member).expect("every dwarf wanders").cooldown = STEP_REST_TICKS;
+        if steps.is_empty() {
+            ecs.entity_mut(member).remove::<Path>();
+        } else {
+            ecs.entity_mut(member).insert(Path(steps));
+        }
+    }
+    let holder = at[&pos];
+    debug_assert_eq!(ecs.get::<Id>(holder), Some(&holder_id));
+    *ecs.get_mut::<Pos>(holder).expect("every dwarf has a position") = path.remove(0);
+    true
+}
