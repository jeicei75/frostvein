+pub mod probe {
+    use std::cell::RefCell;
+    use std::collections::BTreeMap;
+    use std::time::Instant;
+    thread_local!(static ACC: RefCell<BTreeMap<&'static str, f64>> = RefCell::new(BTreeMap::new()));
+    pub struct T(&'static str, Instant);
+    impl T { pub fn new(n: &'static str) -> T { T(n, Instant::now()) } }
+    impl Drop for T {
+        fn drop(&mut self) {
+            let ms = self.1.elapsed().as_secs_f64() * 1000.0;
+            ACC.with(|a| *a.borrow_mut().entry(self.0).or_default() += ms);
+        }
+    }
+    pub fn peek() -> BTreeMap<&'static str, f64> { ACC.with(|a| a.borrow().clone()) }
+    pub fn add(n: &'static str, v: f64) { ACC.with(|a| *a.borrow_mut().entry(n).or_default() += v); }
+    pub fn count(n: &'static str) { ACC.with(|a| *a.borrow_mut().entry(n).or_default() += 1.0); }
+    pub fn take() -> BTreeMap<&'static str, f64> { ACC.with(|a| std::mem::take(&mut *a.borrow_mut())) }
+}
