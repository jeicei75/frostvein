+pub static PROBE: [std::sync::atomic::AtomicU64; 12] = [const { std::sync::atomic::AtomicU64::new(0) }; 12];
+fn probe(i: usize) {
+    PROBE[i].fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+}
+
+fn probe_add(i: usize, n: u64) {
+    PROBE[i].fetch_add(n, std::sync::atomic::Ordering::Relaxed);
+}
+
+fn clear_paths_near(ecs: &mut EcsWorld, at: Pos) {
+    let near = |p: &Pos| (p.x - at.x).abs() <= 2 && (p.y - at.y).abs() <= 2 && (p.z - at.z).abs() <= 2;
+    let entities: Vec<_> = ecs
+        .iter_entities()
+        .filter(|entity| {
+            entity.get::<Path>().is_some_and(|path| {
+                path.0.iter().any(near) || entity.get::<Pos>().is_some_and(near)
+            })
+        })
+        .map(|entity| entity.id())
+        .collect();
+    for entity in entities {
+        ecs.entity_mut(entity).remove::<Path>();
+    }
+}
