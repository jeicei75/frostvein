+    /// PROBE: id, pos, state, job kind (0 none, 1 dig/channel, 2 cut, 3 haul), next path tile,
+    /// carrying, clearing.
+    #[allow(clippy::type_complexity)]
+    pub fn probe_walkers(&self) -> Vec<(u32, Pos, JobState, u8, Option<Pos>, bool, bool)> {
+        let jobs = self.ecs.resource::<Jobs>();
+        self.ecs
+            .iter_entities()
+            .filter(|entity| entity.contains::<Dwarf>())
+            .filter_map(|entity| {
+                let kind = match entity.get::<CurrentJob>()?.0.and_then(|id| jobs.iter().find(|j| j.id == id)) {
+                    None => 0,
+                    Some(job) => match job.kind {
+                        JobKind::Dig | JobKind::Channel => 1,
+                        JobKind::Cut => 2,
+                        JobKind::Haul { .. } => 3,
+                    },
+                };
+                Some((
+                    entity.get::<Id>()?.0,
+                    *entity.get::<Pos>()?,
+                    *entity.get::<JobState>()?,
+                    kind,
+                    entity.get::<Path>().and_then(|p| p.0.first().copied()),
+                    entity.get::<Carrying>()?.0.is_some(),
+                    entity.contains::<Clearing>(),
+                ))
+            })
+            .collect()
+    }
