+pub static PROBE_NS: [std::sync::atomic::AtomicU64; 64] = [const { std::sync::atomic::AtomicU64::new(0) }; 64];
+pub static PROBE_N: [std::sync::atomic::AtomicU64; 64] = [const { std::sync::atomic::AtomicU64::new(0) }; 64];
+pub struct ProbeT(usize, std::time::Instant);
+impl Drop for ProbeT {
+    fn drop(&mut self) {
+        PROBE_NS[self.0].fetch_add(self.1.elapsed().as_nanos() as u64, std::sync::atomic::Ordering::Relaxed);
+        PROBE_N[self.0].fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    }
+}
+pub fn pt(i: usize) -> ProbeT {
+    ProbeT(i, std::time::Instant::now())
+}
+pub fn rev_flood(terrain: &Terrain, closed: &BTreeSet<Pos>, from: Pos, goals: &BTreeSet<Pos>, cap: usize) -> (usize, bool) {
+    let mut seen: BTreeSet<Pos> = goals.iter().copied().filter(|g| is_walkable(terrain, closed, *g) || *g == from).collect();
+    let mut queue: VecDeque<Pos> = seen.iter().copied().collect();
+    while let Some(c) = queue.pop_front() {
+        if c == from { return (seen.len(), true); }
+        if seen.len() > cap { return (seen.len(), true); }
+        for n in astar_neighbours(terrain, closed, c) {
+            if seen.insert(n) { queue.push_back(n); }
+        }
+        if !seen.contains(&from) {
+            // from may be closed? it's excepted; nothing
+        }
+    }
+    (seen.len(), false)
+}
+// slot base b: n[b]=reverse<=64, n[b+1]<=512, n[b+2]<=4096, n[b+3] > 4096 or reached; ns-ish: n[b+4] forward nodes saved when rev<=4096
+fn rev_hist(b: usize, size: usize, enclosed: bool, forward: usize) {
+    if enclosed && size <= 64 { probe_n(b, 1) } else if enclosed && size <= 512 { probe_n(b + 1, 1) } else if enclosed && size <= 4096 { probe_n(b + 2, 1) } else { probe_n(b + 3, 1) }
+    if enclosed && size <= 4096 { probe_n(b + 4, forward as u64) }
+}
+pub fn probe_n(i: usize, n: u64) {
+    PROBE_N[i].fetch_add(n, std::sync::atomic::Ordering::Relaxed);
+}
