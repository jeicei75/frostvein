+/// census: #207's fixture, four bars two deep ringing a 3x3 hole, rock at the corners
+/// (`a_hole_outside_each_piles_own_box_is_still_a_pocket` pins its depths, not a fill).
+#[test]
+fn census_207_four_bars_round_a_hole() {
+    let fire = World::generate(sim_core::DEFAULT_SEED, Dims::DEFAULT).camp_origin();
+    let at = |dx: i32, dy: i32| Pos {
+        x: fire.x + dx,
+        y: fire.y + dy,
+        ..fire
+    };
+    let mut rock = Vec::new();
+    for dx in [-3, -2, 2, 3] {
+        for dy in [-3, -2, 2, 3] {
+            rock.push(at(dx, dy));
+        }
+    }
+    fn bars(fire: Pos) -> Vec<Pos> {
+        let mut cells = Vec::new();
+        for out in [2, 3] {
+            for a in -1..=1i32 {
+                for (dx, dy) in [(a, -out), (a, out), (-out, a), (out, a)] {
+                    cells.push(Pos {
+                        x: fire.x + dx,
+                        y: fire.y + dy,
+                        ..fire
+                    });
+                }
+            }
+        }
+        cells
+    }
+    assert_ring_fills(bars, &rock);
+}
