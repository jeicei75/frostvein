+/// 13.2 scale prototype (throwaway): writes the ten `scale/*.json` scenarios and measures the
+/// camp's walkable component (#159). Run:
+/// `SCALE_OUT=DIR SCALE_TICKS=N cargo test --release -p sim-core --lib scale_generate -- --ignored --nocapture`
+/// The commands come out of the generated world, so every mark and pile cell is valid by
+/// construction; the bench's `commands=applied/total` and the marks left at the end check it.
+#[cfg(test)]
+mod scale_gen {
+    use super::*;
+    use std::collections::{BTreeSet, VecDeque};
+
+    const SIDES: [(i32, i32); 4] = [(-1, 0), (1, 0), (0, -1), (0, 1)];
+    /// Work per dwarf: dig marks (stone to haul) and cut marks (wood to haul).
+    const DIGS_PER_DWARF: usize = 8;
+    const CUTS_PER_DWARF: usize = 1;
+
+    fn component(terrain: &Terrain, blocked: &BTreeSet<Pos>, from: Pos) -> BTreeSet<Pos> {
+        let mut seen = BTreeSet::from([from]);
+        let mut queue = VecDeque::from([from]);
+        while let Some(cell) = queue.pop_front() {
+            for next in astar_neighbours(terrain, blocked, cell) {
+                if seen.insert(next) {
+                    queue.push_back(next);
+                }
+            }
+        }
+        seen
+    }
+
+    fn is_tree(terrain: &Terrain, pos: Pos) -> bool {
+        matches!(
+            terrain.tile(pos),
+            Some(Tile::Solid(Material::TreeTrunk | Material::TreeFoliage))
+        )
+    }
+
+    fn near(a: Pos, target: (i32, i32)) -> i32 {
+        (a.x - target.0).abs() + (a.y - target.1).abs()
+    }
+
+    fn side(cell: Pos, (dx, dy): (i32, i32)) -> Pos {
+        Pos {
+            x: cell.x + dx,
+            y: cell.y + dy,
+            z: cell.z,
+        }
+    }
+
+    /// `want` dig marks: from the diggable cell beside the component nearest `target`, grown
+    /// through diggable side neighbours on that level (so each is reachable once its neighbour is
+    /// dug); the next-nearest edge cell once a level runs out.
+    fn dig_marks(
+        terrain: &Terrain,
+        comp: &BTreeSet<Pos>,
+        fires: &BTreeSet<Pos>,
+        target: (i32, i32),
+        want: usize,
+    ) -> Vec<Pos> {
+        let diggable = |p: Pos| {
+            matches!(terrain.tile(p), Some(Tile::Solid(_)))
+                && !is_tree(terrain, p)
+                && !fires.contains(&Pos { z: p.z + 1, ..p })
+        };
+        let mut edges: Vec<Pos> = comp
+            .iter()
+            .flat_map(|c| SIDES.map(|d| side(*c, d)))
+            .filter(|n| diggable(*n))
+            .collect();
+        edges.sort_by_key(|e| (near(*e, target), *e));
+        edges.dedup();
+        let mut taken = BTreeSet::new();
+        let mut order = Vec::new();
+        for edge in edges {
+            let mut queue = VecDeque::from([edge]);
+            while let Some(p) = queue.pop_front() {
+                if order.len() == want {
+                    return order;
+                }
+                if !taken.insert(p) {
+                    continue;
+                }
+                order.push(p);
+                queue.extend(
+                    SIDES
+                        .map(|d| side(p, d))
+                        .into_iter()
+                        .filter(|n| diggable(*n)),
+                );
+            }
+        }
+        order
+    }
+
+    fn cut_marks(
+        terrain: &Terrain,
+        comp: &BTreeSet<Pos>,
+        target: (i32, i32),
+        want: usize,
+    ) -> Vec<Pos> {
+        let mut bases: BTreeSet<Pos> = comp
+            .iter()
+            .flat_map(|c| SIDES.map(|d| side(*c, d)))
+            .filter_map(|n| tree_of(terrain, n).map(|(base, _)| base))
+            .collect();
+        // A tree is cut from beside its base.
+        bases.retain(|b| {
+            comp.iter()
+                .any(|c| c.z == b.z && SIDES.iter().any(|d| side(*c, *d) == *b))
+        });
+        let mut bases: Vec<Pos> = bases.into_iter().collect();
+        bases.sort_by_key(|b| (near(*b, target), *b));
+        bases.truncate(want);
+        bases
+    }
+
+    /// `want` walkable cells of the component nearest `target`, nearest first.
+    fn pile_cells(comp: &BTreeSet<Pos>, target: (i32, i32), want: usize) -> Vec<Pos> {
+        let mut cells: Vec<Pos> = comp.iter().copied().collect();
+        cells.sort_by_key(|c| (near(*c, target), *c));
+        cells.truncate(want);
+        cells
+    }
+
+    fn rect(p: Pos, q: Pos) -> String {
+        format!(
+            r#"{{"min":[{},{},{}],"max":[{},{},{}]}}"#,
+            p.x, p.y, p.z, q.x, q.y, q.z
+        )
+    }
+
+    #[test]
+    #[ignore = "generator: run by hand, see the module doc"]
+    fn scale_generate() {
+        let out = std::env::var("SCALE_OUT").expect("SCALE_OUT=DIR");
+        let ticks: u64 = std::env::var("SCALE_TICKS")
+            .expect("SCALE_TICKS=N")
+            .parse()
+            .unwrap();
+        for edge in [128u32, 256] {
+            let dims = Dims {
+                x: edge,
+                y: edge,
+                z: 32,
+            };
+            for crew in [5usize, 20, 50, 100, 200] {
+                let world = World::generate_scaled(DEFAULT_SEED, dims, crew);
+                let terrain = world.ecs.resource::<Terrain>();
+                let fires: BTreeSet<Pos> = world.emitters().into_iter().map(|e| e.1).collect();
+                let start = world.dwarves()[0].1;
+                let comp = component(terrain, &fires, start);
+                let walkable: usize = (0..dims.z as i32)
+                    .map(|z| {
+                        (0..edge as i32)
+                            .map(|y| {
+                                (0..edge as i32)
+                                    .filter(|x| terrain.is_standable(Pos { x: *x, y, z }))
+                                    .count()
+                            })
+                            .sum::<usize>()
+                    })
+                    .sum();
+                let e = edge as i32;
+                // Opposite quadrants, each a quarter of the way in from a corner: the camp is at
+                // the centre, so every haul crosses it, and the legs scale with the map.
+                let mine_at = (e / 4, e / 4);
+                let pile_at = (e * 3 / 4, e * 3 / 4);
+                let digs = dig_marks(terrain, &comp, &fires, mine_at, DIGS_PER_DWARF * crew);
+                let cuts = cut_marks(terrain, &comp, mine_at, CUTS_PER_DWARF * crew);
+                let cells = pile_cells(&comp, pile_at, digs.len() + cuts.len());
+                assert_eq!(digs.len(), DIGS_PER_DWARF * crew, "mine too small");
+                assert_eq!(cuts.len(), CUTS_PER_DWARF * crew, "not enough trees");
+                assert_eq!(cells.len(), digs.len() + cuts.len(), "pile too small");
+                let mut commands = Vec::new();
+                let mut command =
+                    |body: String| commands.push(format!(r#"{{"at":6,"command":{body}}}"#));
+                for (kind, marks) in [("dig", &digs), ("cut", &cuts)] {
+                    for p in marks {
+                        command(format!(
+                            r#"{{"type":"designate","kind":"{kind}","rect":{}}}"#,
+                            rect(*p, *p)
+                        ));
+                    }
+                }
+                // One rect per run of cells in a row.
+                let mut rows: BTreeMap<(i32, i32), Vec<i32>> = BTreeMap::new();
+                for c in &cells {
+                    rows.entry((c.z, c.y)).or_default().push(c.x);
+                }
+                let mut rects = Vec::new();
+                for ((z, y), mut xs) in rows {
+                    xs.sort_unstable();
+                    let mut run = (xs[0], xs[0]);
+                    for x in xs.into_iter().skip(1) {
+                        if x == run.1 + 1 {
+                            run.1 = x;
+                        } else {
+                            rects.push(rect(Pos { x: run.0, y, z }, Pos { x: run.1, y, z }));
+                            run = (x, x);
+                        }
+                    }
+                    rects.push(rect(Pos { x: run.0, y, z }, Pos { x: run.1, y, z }));
+                }
+                command(format!(
+                    r#"{{"type":"place_stockpile","rects":[{}]}}"#,
+                    rects.join(",")
+                ));
+                let name = format!("scale-{edge}-crew{crew:03}");
+                let about = format!(
+                    "13.2 Task 4: {crew} dwarves on {edge}x{edge}x32, DEFAULT_SEED. {} dig and {} cut marks nearest ({},{}), a {}-cell pile nearest ({},{}). Made by scale_generate.",
+                    digs.len(),
+                    cuts.len(),
+                    mine_at.0,
+                    mine_at.1,
+                    cells.len(),
+                    pile_at.0,
+                    pile_at.1
+                );
+                let json = format!(
+                    r#"{{"name":"{name}","about":"{about}","start":{{"seed":{DEFAULT_SEED},"dims":[{edge},{edge},32],"crew":{crew}}},"ticks":{ticks},"speed":"fast4x","commands":[{}]}}"#,
+                    commands.join(",\n")
+                );
+                std::fs::write(format!("{out}/{name}.json"), json).unwrap();
+                let mean = |v: &[Pos]| {
+                    (
+                        v.iter().map(|p| p.x as i64).sum::<i64>() / v.len() as i64,
+                        v.iter().map(|p| p.y as i64).sum::<i64>() / v.len() as i64,
+                    )
+                };
+                eprintln!(
+                    "scale {name} camp={:?} component={} walkable_all_levels={walkable} over_cap={} mine_centre={:?} pile_centre={:?} commands={}",
+                    world.camp_origin(),
+                    comp.len(),
+                    comp.len() > MAX_ASTAR_NODES,
+                    mean(&digs),
+                    mean(&cells),
+                    commands.len()
+                );
+            }
+        }
+    }
+}
