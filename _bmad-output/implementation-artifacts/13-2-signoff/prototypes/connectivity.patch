+    /// Point the map at the world's blocked cells: variant I keys it on terrain + emitters + items,
+    /// variant T on terrain + emitters. A changed key drops the labels.
+    fn conn_sync(&self, blocked: &BTreeSet<Pos>, emitters: &BTreeSet<Pos>) {
+        let mode = conn_mode();
+        if mode == 0 {
+            return;
+        }
+        let key = if mode == 2 { blocked } else { emitters };
+        let mut conn = self.conn.lock().expect("nothing panics holding the map");
+        if conn.key != *key {
+            if !conn.comp.is_empty() {
+                counters::add("conn", "map", "rebuild_key", 1);
+                counters::add("conn", "map", "cells_dropped", conn.comp.len() as u64);
+            }
+            conn.key = key.clone();
+            conn.comp.clear();
+            conn.sizes.clear();
+        }
+    }
+
+    /// Label `from`'s whole component under the map's key (once), and return its id.
+    /// `None` when the map cannot speak: off, key not inside `blocked`, or `from` not walkable.
+    fn conn_label(&self, conn: &mut Connectivity, blocked: &BTreeSet<Pos>, from: Pos) -> Option<u32> {
+        if conn_mode() == 0 {
+            return None;
+        }
+        if !conn.key.is_subset(blocked) {
+            counters::add("conn", "map", "skipped_not_subset", 1);
+            return None;
+        }
+        if let Some(&id) = conn.comp.get(&from) {
+            return Some(id);
+        }
+        if !is_walkable(self, &conn.key, from) {
+            return None;
+        }
+        let id = conn.sizes.len() as u32;
+        let key = std::mem::take(&mut conn.key);
+        let mut queue = VecDeque::from([from]);
+        conn.comp.insert(from, id);
+        let mut size = 0_u32;
+        while let Some(cell) = queue.pop_front() {
+            size += 1;
+            for next in astar_neighbours(self, &key, cell) {
+                if let std::collections::btree_map::Entry::Vacant(slot) = conn.comp.entry(next) {
+                    slot.insert(id);
+                    queue.push_back(next);
+                }
+            }
+        }
+        conn.key = key;
+        conn.sizes.push(size);
+        counters::add("conn", "map", "floods", 1);
+        counters::add("conn", "map", "cells", u64::from(size));
+        Some(id)
+    }
+
