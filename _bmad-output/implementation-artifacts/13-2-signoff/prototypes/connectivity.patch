+    /// 13.2 connectivity map: drop every label (a tile changed). Counts only a drop that threw labels away.
+    fn conn_clear(&mut self, why: &'static str) {
+        let conn = self.conn.get_mut().expect("nothing panics holding the map");
+        if !conn.comp.is_empty() {
+            counters::add("conn", "map", why, 1);
+            counters::add("conn", "map", "cells_dropped", conn.comp.len() as u64);
+        }
+        conn.comp.clear();
+        conn.sizes.clear();
