+    /// A system between two chained systems: books the time since the previous lap to system I-1.
+    pub fn lap<const I: usize>() {
+        let now = std::time::Instant::now();
+        if I > 0 {
+            if let Some(last) = LAST.with(Cell::get) {
+                add("time", "system_ns", SYSTEMS[I - 1], (now - last).as_nanos() as u64);
+            }
+        }
+        LAST.with(|c| c.set(Some(now)));
+    }
