+    static DWARF_CLOSED: std::cell::RefCell<BTreeSet<Pos>> = const { std::cell::RefCell::new(BTreeSet::new()) };
+}
+
+/// Step cost onto a stone cell. `FV_CLAMBER_COST` is a knob for the 4-vs-8 A/B only.
+fn clamber_cost() -> u32 {
+    static COST: std::sync::OnceLock<u32> = std::sync::OnceLock::new();
+    *COST.get_or_init(|| {
+        std::env::var("FV_CLAMBER_COST")
+            .ok()
+            .and_then(|v| v.parse().ok())
+            .unwrap_or(4)
+    })
+}
+
+/// Records the uncarried stone cells (emitter cells excluded: fires stay walls).
+fn set_clamber<'a>(
+    emitters: impl Iterator<Item = &'a Pos>,
+    stones: impl Iterator<Item = &'a Pos>,
+) {
+    let emitters: BTreeSet<Pos> = emitters.copied().collect();
+    let cells: BTreeSet<Pos> = stones.filter(|p| !emitters.contains(p)).copied().collect();
+    CLAMBER.with(|c| *c.borrow_mut() = cells);
+    DWARF_CLOSED.with(|c| c.borrow_mut().clear());
+}
+
+fn on_stone(p: Pos) -> bool {
+    CLAMBER.with(|c| c.borrow().contains(&p))
+}
+
+/// A stone cell is crossable by a search, except for `settle`'s landing (that places a dwarf, it is not a walk).
+fn can_clamber(p: Pos) -> bool {
+    counters::caller() != "settle_landing" && on_stone(p) && !DWARF_CLOSED.with(|c| c.borrow().contains(&p))
+}
