+/// 13.2 counters (throwaway, no behaviour change): per-thread tallies of search work, read by
+/// `take`. Thread-local because `cargo test` runs tests on parallel threads; the bench is one.
+pub mod counters {
+    use super::{Pos, World};
+    use std::cell::{Cell, RefCell};
+    use std::collections::BTreeMap;
+
+    type Row = (&'static str, &'static str, &'static str);
+    thread_local! {
+        static CALLER: Cell<&'static str> = const { Cell::new("other") };
+        static ROWS: RefCell<BTreeMap<Row, u64>> = const { RefCell::new(BTreeMap::new()) };
+        static GOAL_CHECKS: Cell<u64> = const { Cell::new(0) };
+        static PREV: RefCell<(u64, Vec<(u32, Pos)>)> = const { RefCell::new((0, Vec::new())) };
+    }
+
+    /// Names the call site of the next `astar`/`route_to_nearest`.
+    pub fn at(name: &'static str) {
+        CALLER.with(|c| c.set(name));
+    }
+    pub(super) fn caller() -> &'static str {
+        CALLER.with(Cell::get)
+    }
+    pub(super) fn add(kind: &'static str, name: &'static str, key: &'static str, n: u64) {
+        ROWS.with(|r| *r.borrow_mut().entry((kind, name, key)).or_insert(0) += n);
+    }
+    pub(super) fn goal_check() {
+        GOAL_CHECKS.with(|c| c.set(c.get() + 1));
+    }
+    pub(super) fn goal_checks() -> u64 {
+        GOAL_CHECKS.with(Cell::get)
+    }
+    pub(super) fn astar(
+        caller: &'static str,
+        nodes: u64,
+        checks: u64,
+        goals_empty: bool,
+        found: bool,
+        budget: bool,
+    ) {
+        add("astar", caller, "calls", 1);
+        add("astar", caller, "nodes", nodes);
+        add("astar", caller, "goal_checks", checks);
+        let end = if goals_empty {
+            "empty"
+        } else if found {
+            "found"
+        } else if budget {
+            "budget"
+        } else {
+            "nopath"
+        };
+        add("astar", caller, end, 1);
+    }
+
+    /// Called at the end of every `World::step`: ticks where two dwarves share a tile, and ticks
+    /// where two dwarves traded tiles since the previous boundary.
+    pub(super) fn tick_boundary(world: &World) {
+        let now: Vec<(u32, Pos)> = world.dwarves().iter().map(|d| (d.0.0, d.1)).collect();
+        let tick = world.tick();
+        let shared = now
+            .iter()
+            .enumerate()
+            .any(|(i, a)| now[i + 1..].iter().any(|b| a.1 == b.1));
+        let swapped = PREV.with(|prev| {
+            let prev = prev.borrow();
+            prev.0 + 1 == tick
+                && now.iter().any(|a| {
+                    now.iter().any(|b| {
+                        a.0 != b.0
+                            && a.1 != b.1
+                            && prev.1.iter().any(|x| x.0 == a.0 && x.1 == b.1)
+                            && prev.1.iter().any(|x| x.0 == b.0 && x.1 == a.1)
+                    })
+                })
+        });
+        PREV.with(|prev| *prev.borrow_mut() = (tick, now));
+        add("emitter", "ticks", "shares", u64::from(shared));
+        add("emitter", "ticks", "swaps", u64::from(swapped));
+        add("emitter", "ticks", "boundaries", 1);
+    }
+
+    /// Returns the tallies, one line per (kind, name) with sorted `key=value` pairs, and resets.
+    pub fn take() -> Vec<String> {
+        let rows = ROWS.with(|r| std::mem::take(&mut *r.borrow_mut()));
+        PREV.with(|p| *p.borrow_mut() = (0, Vec::new()));
+        GOAL_CHECKS.with(|c| c.set(0));
+        CALLER.with(|c| c.set("other"));
+        let mut lines: BTreeMap<(&str, &str), String> = BTreeMap::new();
+        for ((kind, name, key), n) in rows {
+            let line = lines.entry((kind, name)).or_default();
+            line.push_str(&format!(" {key}={n}"));
+        }
+        lines
+            .into_iter()
+            .map(|((kind, name), pairs)| format!("{kind}:{name}{pairs}"))
+            .collect()
+    }
+}
