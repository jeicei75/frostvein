+// PROFILE (13.7 Task 3, throwaway): wall time inside the searches, read by `simd --bench`.
+pub static PROFILE_ASTAR_NS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static PROFILE_ROUTE_NS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+struct ProfileTimer(&'static std::sync::atomic::AtomicU64, std::time::Instant);
+impl Drop for ProfileTimer {
+    fn drop(&mut self) {
+        self.0.fetch_add(self.1.elapsed().as_nanos() as u64, std::sync::atomic::Ordering::Relaxed);
+    }
+}
