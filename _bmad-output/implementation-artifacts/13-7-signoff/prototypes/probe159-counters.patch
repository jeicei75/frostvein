+#[cfg(test)]
+mod probe159 {
+    use super::*;
+    use std::time::Instant;
+
+    #[test]
+    #[ignore]
+    fn probe() {
+        let world = World::generate_with_crew(DEFAULT_SEED, Dims::FRESH, 5);
+        let terrain = world.ecs.resource::<Terrain>();
+        let blocked = blocked_cells(world.emitters().iter().map(|(_, p, _)| p));
+        let dwarves = world.dwarves();
+        let from = dwarves[0].1;
+        println!("dwarves {:?}", dwarves.iter().map(|d| d.1).collect::<Vec<_>>());
+        // component
+        let mut seen = BTreeSet::from([from]);
+        let mut q = VecDeque::from([from]);
+        while let Some(c) = q.pop_front() {
+            for n in astar_neighbours(terrain, &blocked, c) {
+                if seen.insert(n) { q.push_back(n); }
+            }
+        }
+        println!("component {}", seen.len());
+        let d = world.dims();
+        let mut all = BTreeSet::new();
+        for z in 0..d.z as i32 { for y in 0..d.y as i32 { for x in 0..d.x as i32 {
+            let p = Pos{x,y,z}; if is_walkable(terrain, &blocked, p) { all.insert(p); } }}}
+        let mut left: BTreeSet<Pos> = all.difference(&seen).copied().collect();
+        let mut comps = Vec::new();
+        while let Some(&s0) = left.iter().next() {
+            let mut c = BTreeSet::from([s0]); let mut q = VecDeque::from([s0]); left.remove(&s0);
+            while let Some(c0) = q.pop_front() { for n in astar_neighbours(terrain, &blocked, c0) { if left.remove(&n) { c.insert(n); q.push_back(n); } } }
+            comps.push((c.len(), s0));
+        }
+        comps.sort(); comps.reverse();
+        let mut kinds = BTreeMap::new();
+        let mut digfaces = 0; let mut sample = Vec::new();
+        for &(_, s0) in &comps {
+            let below = terrain.tile(Pos{z: s0.z-1, ..s0});
+            *kinds.entry(format!("{:?}", below)).or_insert(0) += 1;
+        }
+        for p in all.difference(&seen) {
+            for side in side_neighbours(*p) {
+                if matches!(terrain.tile(side), Some(Tile::Solid(Material::Stone)) | Some(Tile::Solid(Material::Soil))) {
+                    let ok = side_neighbours(side).into_iter().filter(|c| is_walkable(terrain,&blocked,*c)).all(|c| !seen.contains(&c));
+                    if ok { digfaces += 1; if sample.len() < 40 { sample.push(side); } }
+                }
+            }
+        }
+        println!("island floors {:?}", kinds);
+        println!("unreachable dig targets (stone/soil, every face off-camp): {} e.g. {:?}", digfaces, sample);
+        println!("walkable {} camp {} others {} largest {:?}", all.len(), seen.len(), comps.len(), &comps[..comps.len().min(12)]);
+        // full flood to an unreachable goal, timed
+        let outside = Pos { x: 0, y: 0, z: 31 };
+        for _ in 0..3 {
+            let t = Instant::now();
+            let mut b = 10_000_000usize;
+            let (p, ex, comp) = astar_with_budget(terrain, &blocked, from, &BTreeSet::from([outside]), &mut b);
+            println!("unreachable flood: found={} exhausted={} expanded={} comp={} {:?}", p.is_some(), ex, 10_000_000 - b, comp.len(), t.elapsed());
+        }
+        // sample reachable cells: expansions per search
+        let cells: Vec<Pos> = seen.iter().copied().collect();
+        let mut over = Vec::new();
+        let mut max = 0;
+        let t = Instant::now();
+        for (i, goal) in cells.iter().enumerate() {
+            if i % 97 != 0 { continue; }
+            let mut b = 10_000_000usize;
+            let (p, _, _) = astar_with_budget(terrain, &blocked, from, &BTreeSet::from([*goal]), &mut b);
+            let used = 10_000_000 - b;
+            max = max.max(used);
+            if used > 50_000 { over.push((used, *goal, p.map(|p| p.len()))); }
+        }
+        over.sort();
+        println!("sampled {} max {} over50k {} in {:?}", cells.len() / 97 + 1, max, over.len(), t.elapsed());
+        for o in over.iter().rev().take(15) { println!("  {:?}", o); }
+    }
+}
