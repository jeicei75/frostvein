+pub static PROBE_SITES: std::sync::Mutex<BTreeMap<(u32, bool), usize>> = std::sync::Mutex::new(BTreeMap::new());
+pub static PROBE: [std::sync::atomic::AtomicUsize; 5] = [const { std::sync::atomic::AtomicUsize::new(0) }; 5];
+fn probe_classify(terrain: &Terrain, blocked: &BTreeSet<Pos>, from: Pos, goals: &BTreeSet<Pos>) {
+    use std::sync::atomic::Ordering::Relaxed;
+    if std::env::var_os("PROBE_CLASSIFY").is_none() { PROBE[0].fetch_add(1, Relaxed); return; }
+    let mut b = usize::MAX;
+    let (p, _, _) = astar_with_budget(terrain, blocked, from, goals, &mut b);
+    PROBE[if p.is_some() { 1 } else { 2 }].fetch_add(1, Relaxed);
+    if p.is_some() { PROBE[0].fetch_add(usize::MAX - b, Relaxed); }
+}
