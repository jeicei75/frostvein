index 0000000..b506398
--- /dev/null
+++ b/crates/sim-core/tests/way_down_probe.rs
@@ -0,0 +1,118 @@
+use sim_core::{DesignationKind, Dims, Material, Pos, Rect, SimCommand, Tile, World, Profession};
+
+fn standable(w: &World, p: Pos) -> bool {
+    w.tile(p) == Some(Tile::Empty)
+        && matches!(w.tile(Pos { z: p.z - 1, ..p }), Some(Tile::Solid(_) | Tile::Ramp(_)))
+}
+fn solid(w: &World, p: Pos) -> bool {
+    matches!(w.tile(p), Some(Tile::Solid(m)) if m != Material::TreeTrunk && m != Material::TreeFoliage)
+}
+fn r(a: Pos, b: Pos) -> Rect { Rect { min: a, max: b } }
+fn at(p: Pos, dx: i32, dz: i32) -> Pos { Pos { x: p.x + dx, z: p.z + dz, ..p } }
+
+/// A 5-long row along +x at camp level, every cell and its y-neighbours standable with 6 solid below.
+fn site(w: &World) -> Pos {
+    let c = w.camp_origin();
+    let em: Vec<Pos> = w.emitters().into_iter().map(|(_, p, _)| p).collect();
+    let mut best = None;
+    for by in c.y - 20..c.y + 20 { for bx in c.x - 20..c.x + 20 {
+        let ok = (-1..6).all(|i| (-1..=1).all(|j| {
+            let p = Pos { x: bx + i, y: by + j, z: c.z };
+            standable(w, p) && !em.contains(&p) && (1..7).all(|k| solid(w, Pos { z: c.z - k, ..p }))
+        }));
+        let d = (bx - c.x).abs() + (by - c.y).abs();
+        if ok && d > 3 && best.map_or(true, |(bd, _)| d < bd) { best = Some((d, Pos { x: bx, y: by, z: c.z })); }
+    }}
+    if let Some((_, p)) = best { println!("site {p:?}"); return p; }
+    panic!("no site");
+}
+
+fn run_until(w: &mut World, limit: u64, mut done: impl FnMut(&World) -> bool) -> bool {
+    let end = w.tick() + limit;
+    while w.tick() < end { if done(w) { return true; } w.step(); }
+    done(w)
+}
+
+fn no_marks(w: &World) -> bool { w.designations().is_empty() }
+
+#[test]
+fn walk_down_and_back() {
+    let mut w = World::generate(sim_core::DEFAULT_SEED, Dims::DEFAULT);
+    let t = site(&w);
+    w.apply_command(SimCommand::Designate { kind: DesignationKind::Channel, rect: r(t, t) });
+    assert!(run_until(&mut w, 3000, no_marks), "channel never done");
+    println!("after channel: z-1 {:?} z-2 {:?}; items at {:?}", w.tile(at(t,0,-1)), w.tile(at(t,0,-2)), w.items());
+    let d = Pos { y: t.y + 1, ..at(t, 0, -1) };
+    w.apply_command(SimCommand::Designate { kind: DesignationKind::Dig, rect: r(d, d) });
+    let mut down = None;
+    let ok = run_until(&mut w, 4000, |w| {
+        for (id, p, ..) in w.dwarves() { if p.z == t.z - 1 { down = Some(id); } }
+        w.tile(d) == Some(Tile::Empty)
+    });
+    println!("dig from the pit done={ok} dwarf down={down:?} tick {}", w.tick());
+    assert!(ok);
+    let down = down.unwrap();
+    // pull him back up: give the other miner another trade, mark a channel up top
+    for (id, p) in w.professions() { if p == Profession::Miner && id != down { w.apply_command(SimCommand::SetProfession { dwarf: id, profession: Profession::Hauler }); } }
+    let u = at(t, 4, 0);
+    w.apply_command(SimCommand::Designate { kind: DesignationKind::Channel, rect: r(u, u) });
+    let up = run_until(&mut w, 4000, |w| w.dwarves().iter().any(|(id, p, ..)| *id == down && p.z == t.z));
+    println!("pit dwarf back up: {up} tick {}", w.tick());
+    assert!(up);
+}
+
+#[test]
+fn staircase() {
+    let mut w = World::generate(sim_core::DEFAULT_SEED, Dims::DEFAULT);
+    let t = site(&w);
+    if std::env::var_os("PROBE_PILE").is_some() {
+        let c = w.camp_origin();
+        let refused = w.apply_command(SimCommand::PlaceStockpile { rect: r(Pos { x: c.x - 8, y: c.y + 2, z: c.z }, Pos { x: c.x + 8, y: c.y + 9, z: c.z }) });
+        println!("pile refused={refused:?} zones={}", w.zones().len());
+    }
+    for lvl in 0..4 {
+        let a = at(t, lvl, -lvl);
+        let b = Pos { y: t.y + if std::env::var_os("PROBE_WIDE").is_some() { 1 } else { 0 }, ..at(t, 4, -lvl) };
+        let refused = w.apply_command(SimCommand::Designate { kind: DesignationKind::Channel, rect: r(a, b) });
+        println!("lvl {lvl} rect {a:?}..{b:?} marks {}", w.designations().len());
+        let ok = run_until(&mut w, 8000, no_marks);
+        println!("level {lvl}: refused={refused:?} all worked={ok} left={:?} tick {}", w.designations(), w.tick());
+        if !ok {
+            for z in (5..=9).rev() { let row: Vec<String> = (60..68).map(|x| { let p = Pos{x, y: t.y, z}; let it = w.items().iter().any(|(_, q)| *q == p); let dw = w.dwarves().iter().any(|d| d.1 == p);
+                format!("{}{}", match w.tile(p) { Some(Tile::Empty) => ".", Some(Tile::Ramp(_)) => "/", Some(Tile::Solid(_)) => "#", _ => "?" }, if dw {"D"} else if it {"*"} else {" "}) }).collect(); println!("z{z} x60..67: {}", row.join("")); }
+            println!("items {:?}", w.items());
+            println!("dwarves {:?}", w.dwarves()); println!("prof {:?}", w.professions()); println!("jobs {:?}", w.jobs()); println!("claims {:?}", w.claims());
+            return;
+        }
+    }
+    let bottom = at(t, 4, -4);
+    println!("floating items {}", w.items().iter().filter(|(_, p)| !standable(&w, *p)).count());
+    println!("bottom {:?} tile {:?} under {:?}", bottom, w.tile(bottom), w.tile(at(bottom, 0, -1)));
+    let e = at(bottom, 1, 0);
+    w.apply_command(SimCommand::Designate { kind: DesignationKind::Dig, rect: r(e, e) });
+    let ok = run_until(&mut w, 6000, |w| w.tile(e) == Some(Tile::Empty));
+    println!("dig at the bottom (z {}) done={ok}; min dwarf z seen now {:?}", e.z, w.dwarves().iter().map(|d| d.1.z).min());
+}
+
+#[test]
+fn staircase_delay_sweep() {
+    let mut ok_n = 0;
+    let mut red = vec![];
+    for delay in 0..24u64 {
+        let mut w = World::generate(sim_core::DEFAULT_SEED, Dims::DEFAULT);
+        let t = site(&w);
+        let c = w.camp_origin();
+        w.apply_command(SimCommand::PlaceStockpile { rect: r(Pos { x: c.x - 8, y: c.y + 2, z: c.z }, Pos { x: c.x + 8, y: c.y + 9, z: c.z }) });
+        let mut reached = 0;
+        for lvl in 0..4 {
+            for _ in 0..delay { w.step(); }
+            let a = at(t, lvl, -lvl);
+            let b = Pos { y: t.y + 1, ..at(t, 4, -lvl) };
+            w.apply_command(SimCommand::Designate { kind: DesignationKind::Channel, rect: r(a, b) });
+            if !run_until(&mut w, 6000, no_marks) { break; }
+            reached = lvl + 1;
+        }
+        if reached == 4 { ok_n += 1 } else { red.push((delay, reached)); }
+    }
+    println!("sweep: OK {ok_n}/24; stalled (delay, levels done): {red:?}");
+}
