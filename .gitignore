# --- BMad: vendored core is ignored; only our own surface is tracked ---
_bmad/*
!_bmad/scripts/
_bmad/scripts/*
!_bmad/scripts/session_tokens.py
!_bmad/scripts/phase_state.py
!_bmad/scripts/record_phase_on_exit.py
!_bmad/scripts/tests/
_bmad/scripts/tests/*
!_bmad/scripts/tests/test_session_tokens.py
!_bmad/scripts/tests/test_phase_metric_hook.py
!_bmad/custom/
_bmad/custom/*
!_bmad/custom/bmad-create-story.toml
!_bmad/custom/bmad-dev-story.toml
!_bmad/custom/bmad-code-review.toml
!_bmad/custom/bmad-sprint-status.toml
!_bmad/custom/bmad-review-patch.toml
.claude/
.agents/
.codex/

# --- Python (uv resolves HERE now, not the forge; see pyproject.toml) ---
/.venv
__pycache__/
*.pyc

# --- Rust ---
/target
/frostvein.save
/frostvein.save.tmp

# --- secrets ---
.env*
*secret*
*token*
*.pem
*.key

# --- re-includes that must come AFTER the secret patterns (*token* matches these) ---
!_bmad/scripts/session_tokens.py
!_bmad/scripts/tests/test_session_tokens.py

# Windows Mark-of-the-Web streams, created by every file copied from the vehicle.
*:Zone.Identifier

# Blender autosave backups (.blend1, .blend2, ...) -- never a deliverable.
*.blend[0-9]

# Art export scratch. The generators write straight to assets/trees/ and assets/gltf/;
# a second committed copy of a shipped .glb is how a bench and a client come to draw
# different trees (scripts/bench/authored_bench.py:55-58).
src-assets/export/

# The vehicle's binary drop. `scripts/launch-gui.ps1` defaults to `.bin/gui.exe` inside the
# checkout, so the binary and the assets it serves come from one place.
#
# IGNORED IS LOAD-BEARING, not tidiness: `crates/gui/build.rs` derives the `-dirty` suffix from
# `git status --porcelain`, which counts UNTRACKED files. An un-ignored `.bin/gui.exe` would make
# every build in that checkout stamp `-dirty`, and the launcher refuses a dirty stamp -- so the
# drop directory would break the very check it exists to feed.
.bin/
