#!/usr/bin/env bash
# Runs the FAST tier of the frostvein gate before every push, scoped to what the push carries.
#
# ENABLE (once per clone):  git config core.hooksPath .githooks
#
# CHANGED 2026-09-08 (Wolf: "it runs gate and timeouts because it takes forever ... and I think
# it does the same when committing so double work"). He is right on both counts, and the scope
# block in gate.sh had already flagged this as "a separate call". MEASURED that day:
#
#   pre-commit (fast tier)   50-95 s
#   pre-push   (full gate)   707 s, of which 603 s was the pixel guards
#
# and the full gate RE-RAN fmt, clippy, every non-serve test, both Python suites and the
# mutation audit — all of which the commit hook had just run. So a push paid ~90 s of pure
# duplication and then several minutes more for the heavy tier, inside a hook, where no
# interactive git client will wait for it.
#
# It was also actively breaking pushes: issue #76 records GitHub closing the connection
# mid-hook, leaving a GREEN gate and an UNPUSHED branch. A multi-minute pre-push hook is not
# a stricter gate, it is a flakier one.
#
# WHAT NOW COVERS THE HEAVY TIER: `scripts/gate.sh` with no arguments, run explicitly. Every
# story already requires it green before it can be called done, and the dev workflow runs it
# at the end of a story rather than on every push of a work-in-progress branch. The coverage
# did not move out of the project; it moved out of the keystroke.
#
# THE TRADE, stated plainly so it is a decision and not a drift: a push can now happen whose
# tip never saw serve.rs or the pixel guards. What holds the line is the story gate plus this
# repo's standing rule that push and PR need Wolf's explicit yes.
#
# `git push --no-verify` still bypasses it, deliberately and visibly.
#
# NOTE this repo's standing rule: push/PR only on Wolf's explicit yes. This hook does not
# grant permission to push — it makes a push that DOES happen carry a green gate.
#
# WHY IT PARSES STDIN (2026-09-05): git hands a pre-push hook one line per ref being pushed —
# `<local ref> <local sha> <remote ref> <remote sha>` — and this hook used to throw it away and
# `exec` the full gate regardless. That range is the right question, and it is specifically NOT
# `main..HEAD`: every M2 story branch is stacked, so a range against main is wrong by default
# (epic-5-retro-2026-08-23.md:193). gate.sh --range decides from it which heavy checks the push
# could possibly move, and names every one it skips. See the scope block in scripts/gate.sh.
#
# CONSERVATIVE BY CONSTRUCTION: anything this cannot read exactly — more than one ref in a
# single push, a brand-new branch whose range is unbounded, a remote sha this clone does not
# have — falls through to the full gate. The narrowing only happens when the range is certain.

set -uo pipefail

gate="$(git rev-parse --show-toplevel)/scripts/gate.sh"
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')

refs=0
push_local=""
push_remote=""
deletions=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  if [ "$local_sha" = "$zero" ]; then
    deletions=$((deletions + 1))
    continue
  fi
  refs=$((refs + 1))
  push_local="$local_sha"
  push_remote="${remote_sha:-}"
done

# A deletion carries no content, so there is nothing for a quality gate to judge.
if [ "$refs" -eq 0 ] && [ "$deletions" -gt 0 ]; then
  echo "frostvein gate: branch deletion only, nothing to check"
  exit 0
fi

# `--fast` IS a scope decision, so gate.sh refuses it alongside `--range`. The range parsing
# above is kept because it is the right question and the heavy tier may return here if the
# heavy checks ever get cheap enough to hold a push open for.
echo "frostvein gate: FAST tier on push -- serve.rs and the pixel guards are NOT run here."
echo "  Run 'scripts/gate.sh' with no arguments before calling a story done."
exec "$gate" --fast
